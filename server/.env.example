DATABASE_URL="postgresql://transport:transport_password@localhost:5432/vanuatu_transport?schema=public"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
PORT=3000
CLIENT_ORIGIN="http://localhost:8081"

# Required by `yarn seed:admin`. Keep these values private and use a unique password.
ADMIN_EMAIL="admin@midriver.com"
ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"
ADMIN_PHONE="+6780000000"

# The SMS gateway must accept POST JSON { "to": "+678...", "message": "..." }
# with an Authorization: Bearer <API key> header. HTTPS is required in production.
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""